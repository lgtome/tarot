{
  "expo": {
    "name": "Tarot Cards",
    "slug": "tarot-cards",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.naayaaoops.tarotcards",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.naayaaoops.tarotcards"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.748833929545-20qbo095b9fvbl1d6amaosk8onr0ecet"
        }
      ]
    ],
    "scheme": "com.naayaaoops.tarotcards",
    "extra": {
      "eas": {
        "projectId": "72732ac4-b638-4edc-84d2-1363d3566f53"
      }
    },
    "owner": "naayaa-oops"
  }
}
