{
  "name": "@tarot-cards/mobile",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "build": "expo export",
    "codegen": "graphql-codegen --config codegen.ts && prettier --write \"src/graphql/generated.ts\""
  },
  "dependencies": {
    "@apollo/client": "^3.13.8",
    "@expo-google-fonts/gideon-roman": "^0.3.0",
    "@expo/metro-runtime": "~5.0.4",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-google-signin/google-signin": "^14.0.1",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.12",
    "expo": "^53.0.9",
    "expo-apple-authentication": "^7.2.4",
    "expo-auth-session": "^6.1.5",
    "expo-crypto": "^14.1.4",
    "expo-dev-client": "~5.1.8",
    "expo-font": "^13.3.1",
    "expo-localization": "^16.1.5",
    "expo-splash-screen": "^0.30.8",
    "expo-web-browser": "^14.1.6",
    "graphql": "^16.11.0",
    "i18next": "^25.1.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "^15.5.1",
    "react-native": "0.79.2",
    "react-native-get-random-values": "^1.11.0",
    "react-native-safe-area-context": "^5.4.1",
    "react-native-screens": "^4.10.0",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.6",
    "@graphql-codegen/introspection": "^4.0.3",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3"
  },
  "private": true
}
